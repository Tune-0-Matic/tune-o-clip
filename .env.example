# Copy to .env (setup_linux.sh does it once) and fill in. .env holds secrets: never share or commit it.

# Required for Twitch clips: https://dev.twitch.tv/console/apps (Category: Application Integration)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Discord alerts (blocked downloads, failed jobs, low disk)
DISCORD_WEBHOOK_URL=

# Optional: auto-posting (publisher/)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional overrides (normally detected automatically)
# TOC_LOW_SPEC=1          # 1 = CPU Whisper + warm Ollama + 4 ffmpeg threads (auto on Linux with <= 8 GB RAM)
# TOC_OLLAMA_TIMEOUT=60   # seconds per Ollama call (auto: 60 on that Linux box, 45 elsewhere)
# TOC_OLLAMA_MODEL=qwen2.5:1.5b   # judge / director model (setup_linux.sh writes this; default: the calibrated 3B)
# TOC_MIN_FREE_GB=5       # harvesting pauses below this much free disk

# Optional: RunPod cloud GPU (panel: RUNPOD GPU ON/OFF). The key is saved here by the panel's RUNPOD KEY button.
RUNPOD_API_KEY=
# a Pod is terminated once one session has cost this much (elapsed x $/hr), or this long after the last run
RUNPOD_MAX_SESSION_USD=1.50
RUNPOD_IDLE_TIMEOUT_MIN=10
# RUNPOD_GPU_ID=NVIDIA RTX 4000 Ada Generation   # tried first; RTX 3090 / 4090 are the fallbacks
# RUNPOD_IMAGE=ghcr.io/tune-0-matic/tune-o-clip-pod:v1   # pre-baked (scripts/build_runpod_image.*): Ready in seconds once the host has it; unset = generic image + full install
