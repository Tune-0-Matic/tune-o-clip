{
    "css": "styles.css",
    "layout": {
        "max_width_ratio": 0.86,
        "max_number_of_lines": 2,
        "min_number_of_lines": 1,
        "vertical_align": {"align": "center", "offset": 0.22}
    },
    "effects": [
        {"type": "remove_punctuation_marks", "punctuation_marks": [".", ","], "exception_marks": ["..."]}
    ],
    "animations": [
        {"type": "zoom_in_primitive", "when": "narration-starts", "what": "word", "duration": 0.12,
         "init_scale": 0.8, "overshoot": {"amount": 0.1, "peak_at": 0.6}},
        {"type": "fade_out", "when": "narration-ends", "what": "segment", "duration": 0.08}
    ],
    "sound_effects": [
        {"type": "preset", "name": "pop", "when": "narration-starts", "what": "word", "tag_condition": "hype", "volume": 0.12}
    ],
    "tagger_rules": [
        {"type": "regex", "tag": "hype", "regex": "(?i)\\b(?:let'?s go|no+|what+|bro+|yo+|oh my god|omg|insane|crazy|clutch|dead|died|kill(?:ed)?|win|won|lost|run|wait|stop|help|gta|police|cops?|wanted|money|crash(?:ed)?|boom|why+|how+|huh|wow|nah|yes+)\\b"}
    ]
}
